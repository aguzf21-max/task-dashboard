# Local Docker Compose defaults. Copy to .env and replace only if needed.
POSTGRES_DB=mentoring
POSTGRES_USER=mentoring
POSTGRES_PASSWORD=local-development-password
REDIS_PASSWORD=
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Applications exposed by Docker Compose
API_PORT=3000
WEB_PORT=3001

# Browser origins that may call the API; comma-separated
ALLOWED_CORS_ORIGINS=http://localhost:3001

# Development-only placeholders. Production must provide real key locations
# and either KMS_KEY_ID or a securely injected AES_KEY.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
AES_KEY=
KMS_KEY_ID=
