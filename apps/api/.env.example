NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mentoring
DATABASE_USER=mentoring
DATABASE_PASSWORD=local-development-password
DATABASE_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
ALLOWED_CORS_ORIGINS=http://localhost:3001
TENANCY_DEVELOPMENT_HEADER_ENABLED=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IAM_ENCRYPTION_KEY=
REDIS_SECURITY_REQUIRED=true

# Do not commit these production secrets. In production set both JWT paths
# and set either AES_KEY (32+ bytes) or KMS_KEY_ID.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
AES_KEY=
KMS_KEY_ID=
